{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zuno",
  "version": "0.0.6",
  "identifier": "dev.zuno.player",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zuno",
        "width": 1120,
        "height": 740,
        "minWidth": 360,
        "minHeight": 540,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png"
    ]
  }
}
